# Configuration de la publication sur le web (Cloudflare Tunnel).
# Copiez ce fichier en « .env » (hors Git) et indiquez votre propre adresse :
#   cp .env.example .env
#
# Adresse publique du jeu : un sous-domaine d'un domaine géré par votre compte Cloudflare
PUBLIC_HOSTNAME=echecs.example.com
# Nom du tunnel Cloudflare dédié au jeu
TUNNEL_NAME=echecs
